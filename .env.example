# Copiar a .env y reemplazar TODOS los valores. El archivo .env nunca se sube a GitHub.
# Usar solo letras y números en contraseñas (los scripts de inicialización de BD las insertan en SQL).
# Generar secretos con:  php -r "echo bin2hex(random_bytes(32));"

# --- MariaDB de negocio (master) ---
DB_ROOT_PASSWORD=cambiar_root_master
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=cambiar_auth_password
CATALOGO_DB_USER=catalogo_user
CATALOGO_DB_PASSWORD=cambiar_catalogo_password
PEDIDOS_DB_USER=pedidos_user
PEDIDOS_DB_PASSWORD=cambiar_pedidos_password
PAGOS_DB_USER=pagos_user
PAGOS_DB_PASSWORD=cambiar_pagos_password

# --- Replicación Master-Slave ---
DB_SLAVE_ROOT_PASSWORD=cambiar_root_slave
REPLICATION_USER=replicador
REPLICATION_PASSWORD=cambiar_replication_password

# --- MariaDB de auditoría (contenedor y volumen separados) ---
AUDIT_DB_ROOT_PASSWORD=cambiar_root_audit
AUDIT_DB_USER=audit_writer
AUDIT_DB_PASSWORD=cambiar_audit_password

# --- Redis (lista negra de JWT y caché) ---
REDIS_PASSWORD=cambiar_redis_password

# --- JWT (mínimo 32 caracteres cada uno, distintos entre sí) ---
JWT_SECRET=cambiar_por_64_caracteres_hex_aleatorios_para_tokens_de_usuario
JWT_SERVICE_SECRET=cambiar_por_otros_64_caracteres_hex_para_tokens_de_servicio

# --- Administrador inicial (se crea al arrancar auth-service si no existe) ---
ADMIN_NOMBRE=Administrador SuperAhorro
ADMIN_EMAIL=admin@superahorro.gt
ADMIN_PASSWORD=CambiarEsta2026

# --- Cloudinary (cloudinary.com > Dashboard > API Keys). Vacío = subida de imágenes deshabilitada ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- APIs externas (todas con plan gratuito / modo test) ---
# Sin claves Stripe el sistema usa modo demo de pago (gratis, para desarrollo).
PUBLIC_BASE_URL=http://localhost
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
OPENWEATHER_API_KEY=
